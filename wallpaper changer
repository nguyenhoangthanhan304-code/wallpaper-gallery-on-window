# Windows wallpaper setter
# ═══════════════════════════════════════════════════════════════════

def set_windows_wallpaper(image_path: str):
    """Set the Windows desktop wallpaper via SystemParametersInfoW."""
    SPI_SETDESKWALLPAPER = 0x0014
    SPIF_UPDATEINIFILE   = 0x0001
    SPIF_SENDCHANGE      = 0x0002
    try:
        ctypes.windll.user32.SystemParametersInfoW(
            SPI_SETDESKWALLPAPER, 0, image_path,
            SPIF_UPDATEINIFILE | SPIF_SENDCHANGE
        )
        print(f"[gallery] Wallpaper set: {image_path}")
    except Exception as e:
        print(f"[gallery] Could not set wallpaper: {e}")


class _WallpaperApplier(QObject):
    """Sets the Windows wallpaper on a background thread.

    SystemParametersInfoW with SPIF_SENDCHANGE broadcasts to every top
    level window and can block for a noticeable time, which would freeze
    the GUI (and the fade-out) if it ran on the GUI thread. `done` is
    emitted once Windows has returned from the call."""

    done = pyqtSignal()

    def apply(self, path: str):
        def _work():
            try:
                set_windows_wallpaper(path)
            finally:
                self.done.emit()
        threading.Thread(target=_work, daemon=True).start()



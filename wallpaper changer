}


def _sample_dominant_color(path: str, n: int = 40) -> tuple[int,int,int] | None:
    try:
        px = QPixmap(path)
        if px.isNull():
            return None
        sm  = px.scaled(n, n, Qt.AspectRatioMode.IgnoreAspectRatio,
                        Qt.TransformationMode.FastTransformation)
        img = sm.toImage()
        rs = gs = bs = count = 0
        for y in range(sm.height()):
            for x in range(sm.width()):
                c = QColor(img.pixel(x, y))
                rs += c.red(); gs += c.green(); bs += c.blue(); count += 1
        return (rs // count, gs // count, bs // count) if count else None
    except Exception:
        return None


def _color_dist(a, b) -> float:
    return math.sqrt(sum((x-y)**2 for x, y in zip(a, b)))


def _matches_color(wp: Wallpaper, key: str, cache: dict) -> bool:
    if not wp.thumbnail_path:
        return False
    if wp.path not in cache:
        cache[wp.path] = _sample_dominant_color(wp.thumbnail_path)
    dom = cache[wp.path]
    if dom is None:
        return False
    return any(_color_dist(dom, a) < 80 for a in COLOR_ANCHORS.get(key, []))


# ═══════════════════════════════════════════════════════════════════
# Carousel geometry constants
# ═══════════════════════════════════════════════════════════════════

# Center card
CENTER_W  = 200
CENTER_H  = 600

# Side cards (index 1) – start size
SIDE1_W   = 160
SIDE1_H   = 650

# Minimum side card size (applied from index 7 onward)
SIDE_MIN_W = 100
SIDE_MIN_H = 240

# How many steps of shrinking before clamping
SHRINK_STEPS = 7          # indices 1–6 shrink; ≥7 stay at min

# Horizontal gap between adjacent card edges
CARD_GAP  = 10

# Slide durations, in ms.
#   ANIM_MS       — a fresh slide starting from rest.
#   ANIM_MS_FAST  — used when a new scroll input interrupts a slide that's
#                   still in flight, so rapid scrolling feels snappier
#                   instead of sluggish.
ANIM_MS      = 220
ANIM_MS_FAST = 120

SHEAR_DEG    = 0         # parallelogram lean in degrees

# Opacity applied to non-centre ("side") cards.
# 1.0 = fully opaque (no dimming), 0.0 = fully transparent.
# Tweak this decimal to taste.
SIDE_CARD_OPACITY: float = 0.8
CENTER_CARD_OPACITY: float = 0.8

# Wallpaper-apply reveal animation
REVEAL_WIPE_MS = 2000   # <-- adjust this: duration of the diagonal wipe (ms)
REVEAL_HOLD_MS = 1200   # <-- adjust this: how long the reveal image stays on
                        #     screen AFTER Windows has set the real wallpaper,
                        #     so Windows' own wallpaper swap (which can flash
                        #     blank for about a second) is never visible
REVEAL_FADE_MS = 280    # duration of the reveal image fading out at the end
CLOSE_FADE_MS  = 200    # duration of the gallery window fading out/closing

# Thumbnail loading
THUMB_JPEG_QUALITY = 85
PREFETCH_SIDE      = 24                   # extra cards prefetched beyond the screen edge
THUMB_MEM_BUDGET   = 384 * 1024 * 1024    # bytes of decoded thumbnails kept in RAM


def shear_for_height(h: int) -> int:
    return int(h * math.tan(math.radians(SHEAR_DEG)))


def _card_size(distance: int) -> tuple[int, int]:
    """Return (w, h) for a card at `distance` positions from centre."""
    if distance == 0:
        return CENTER_W, CENTER_H
    # Clamp distance to SHRINK_STEPS
    d = min(distance, SHRINK_STEPS)
    t = d / SHRINK_STEPS          # 0 → 1
    w = int(SIDE1_W + t * (SIDE_MIN_W - SIDE1_W))
    h = int(SIDE1_H + t * (SIDE_MIN_H - SIDE1_H))
    return w, h


def _advance(distance: int) -> int:
    """Horizontal space one card at `distance` takes, including its gap."""
    w, h = _card_size(distance)
    return w + shear_for_height(h) + CARD_GAP


def _run(n: int) -> int:
    """Total horizontal space of the cards at distances 1..n (O(1) for any
    n, since every card from SHRINK_STEPS onward has the same size)."""
    if n <= 0:
        return 0
    head  = min(n, SHRINK_STEPS)
    total = sum(_advance(i) for i in range(1, head + 1))
    if n > head:
        total += (n - head) * _advance(SHRINK_STEPS)
    return total


def _thumb_master_size() -> tuple[int, int]:
    """Size (in physical pixels) of the cached thumbnail "master": the
    tallest card's full height, at the widest aspect ratio any card can
    show. Every card's view of an image fits inside this crop."""
    sizes = [_card_size(d) for d in range(SHRINK_STEPS + 1)]
    max_h = max(h for _w, h in sizes)
    aspect = max((w + shear_for_height(h) + 4) / h for w, h in sizes)
    mh = int(max_h * _DPR)
    return int(math.ceil(aspect * mh)), mh


def _thumb_cache_path(path: str) -> str:
    """Deterministic on-disk cache location for a source image's
    pre-scaled thumbnail. Keyed on path + mtime + target size, so an
    edited/replaced file naturally gets a fresh cache entry."""
    try:
        mtime = int(os.path.getmtime(path))
    except OSError:
        mtime = 0
    max_w, max_h = _thumb_master_size()
    key = f"{os.path.normcase(path)}|{max_w}x{max_h}|{mtime}"
    digest = hashlib.md5(key.encode("utf-8")).hexdigest()
    return os.path.join(THUMB_CACHE_DIR, digest + ".jpg")


# ═══════════════════════════════════════════════════════════════════
# Background thumbnail loading
# ═══════════════════════════════════════════════════════════════════

class _ThumbnailSignals(QObject):
    # (source_path, loaded_image) — emitted from the worker thread,
    # delivered to the GUI thread automatically via a queued connection
    # because sender and receiver live on different threads.
    # A null image means "skipped" (no longer wanted).
    finished = pyqtSignal(str, QImage)
    failed   = pyqtSignal(str)          # file could not be decoded


class ThumbnailLoadTask(QRunnable):
    """Loads (or generates + caches) a downscaled thumbnail for one
    wallpaper off the GUI thread. Only QImage is touched here — QPixmap
    is not thread-safe and must only be created back on the GUI thread."""

    def __init__(self, path: str, is_wanted=None):
        super().__init__()
        self.path = path
        self.is_wanted = is_wanted
        self.signals = _ThumbnailSignals()

    def run(self):
        # The user may have scrolled far away while this was queued.
        if self.is_wanted is not None and not self.is_wanted(self.path):
            self.signals.finished.emit(self.path, QImage())
            return

        cache_path = _thumb_cache_path(self.path)
        image = QImage()

        if os.path.isfile(cache_path):
            image.load(cache_path)

        if image.isNull():
            src = QImage(self.path)
            if src.isNull():
                self.signals.failed.emit(self.path)
                return
            max_w, max_h = _thumb_master_size()
            if src.width() > max_w or src.height() > max_h:
                image = src.scaled(
                    max_w, max_h,
                    Qt.AspectRatioMode.KeepAspectRatioByExpanding,
                    Qt.TransformationMode.SmoothTransformation,
                )
                # Keep only the centre crop that cards can actually show.
                cw, ch = min(max_w, image.width()), min(max_h, image.height())
                image = image.copy((image.width() - cw) // 2,
                                   (image.height() - ch) // 2, cw, ch)
            else:
                image = src
            try:
                os.makedirs(THUMB_CACHE_DIR, exist_ok=True)
                image.save(cache_path, "JPG", THUMB_JPEG_QUALITY)
            except Exception:
                pass  # cache write failing is not fatal, just slower next time

        self.signals.finished.emit(self.path, image)



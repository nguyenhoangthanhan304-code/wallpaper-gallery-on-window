IMAGE_EXTS = {".jpg", ".jpeg", ".png", ".webp", ".bmp", ".gif", ".tiff", ".tif"}
VIDEO_EXTS = {".mp4", ".mkv", ".avi", ".mov", ".webm", ".wmv", ".flv"}

APP_DATA_DIR = os.path.join(
    os.environ.get("LOCALAPPDATA", os.path.expanduser("~")),
    "WallpaperGallery",
)
FAVORITES_FILE = os.path.join(APP_DATA_DIR, "favorites.json")
THUMB_CACHE_DIR = os.path.join(APP_DATA_DIR, "thumbcache")


def _load_favorites() -> set[str]:
    try:
        with open(FAVORITES_FILE, "r", encoding="utf-8") as f:
            return set(json.load(f))
    except Exception:
        return set()


def _save_favorites(favs: set[str]):
    try:
        os.makedirs(os.path.dirname(FAVORITES_FILE), exist_ok=True)
        with open(FAVORITES_FILE, "w", encoding="utf-8") as f:
            json.dump(sorted(favs), f, indent=2)
    except Exception as e:
        print(f"[gallery] Could not save favorites: {e}")


class Wallpaper:
    """A single wallpaper (image or video) discovered on disk."""

    def __init__(self, path: str):
        self.path      = path
        self.title     = Path(path).stem
        self.ext       = Path(path).suffix.lower()
        self.is_image  = self.ext in IMAGE_EXTS
        self.is_video  = self.ext in VIDEO_EXTS
        # For images: the file itself is the thumbnail.
        # For video: we just show a placeholder (no ffmpeg dependency).
        self.thumbnail_path: str | None = path if self.is_image else None

    def activate(self):
        if self.is_image:
            set_windows_wallpaper(self.path)
        else:
            print(f"[gallery] Video wallpaper activation not implemented: {self.path}")

    def __repr__(self):
        return f"<Wallpaper {self.title!r}>"


def _wallpaper_search_roots() -> list[str]:
    """Return candidate folders that usually contain wallpapers."""
    roots = []
    userprofile = os.environ.get("USERPROFILE", os.path.expanduser("~"))
    windir      = os.environ.get("WINDIR", r"C:\Windows")

    # User pictures
    roots.append(os.path.join(os.environ["OneDrive"], "Pictures", "Wallpapers"))

    return roots


def scan_wallpapers(extra_paths: list[str] | None = None) -> list[Wallpaper]:
    """Recursively find wallpaper files in known locations."""
    search = _wallpaper_search_roots()
    if extra_paths:
        search.extend(extra_paths)

    seen:       set[str]       = set()
    wallpapers: list[Wallpaper] = []

    for root in search:
        if not os.path.isdir(root):
            continue
        for dirpath, _dirs, files in os.walk(root):
            for fname in sorted(files):
                ext = Path(fname).suffix.lower()
                if ext not in IMAGE_EXTS and ext not in VIDEO_EXTS:
                    continue
                full = os.path.join(dirpath, fname)
                norm = os.path.normcase(full)
                if norm in seen:
                    continue
                seen.add(norm)
                wallpapers.append(Wallpaper(full))
                print(f"[gallery] Found: {full}")

    wallpapers.sort(key=lambda w: w.title.lower())
    print(f"[gallery] Total: {len(wallpapers)} wallpapers")
    return wallpapers


